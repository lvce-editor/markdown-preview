{
  "id": "builtin.markdown-preview",
  "name": "Markdown Preview",
  "description": "Markdown Preview",
  "browser": "dist/markdownPreviewMain.js",
  "isolated": true,
  "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'"],
  "activation": ["onWebView:builtin.markdown-preview"],
  "languages": [],
  "rpc": [
    {
      "id": "builtin.markdown-preview.markdown-preview-worker",
      "type": "web-worker",
      "name": "Markdown Preview Worker",
      "url": "../markdown-preview-worker/src/markdownPreviewWorkerMain.ts",
      "contentSecurityPolicy": ["default-src 'none'"]
    }
  ],
  "webViews": [
    {
      "id": "builtin.markdown-preview",
      "name": "Markdown Preview",
      "type": "preview",
      "rpc": "builtin.markdown-preview.markdown-preview-worker",
      "path": "media/index.html",
      "selector": [".md"],
      "contentSecurityPolicy": ["default-src 'none'", "script-src 'self'", "style-src 'self'", "img-src 'self' https:"],
      "elements": [
        {
          "type": "title",
          "value": "Markdown Preview"
        },
        {
          "type": "script",
          "path": "media/index.js"
        },
        {
          "type": "css",
          "path": "media/markdown.css"
        },
        {
          "type": "css",
          "path": "media/index.css"
        }
      ]
    }
  ]
}
