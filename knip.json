{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "project": ["*.js"]
    },
    "packages/build": {
      "entry": ["src/build.js", "src/build-static.js", "src/computeNodeModulesCacheKey.js"],
      "project": ["src/**/*.js"],
      "ignoreDependencies": ["@lvce-editor/shared-process", "esbuild"]
    },
    "packages/e2e": {
      "entry": ["src/**/*.js"],
      "project": ["src/**/*.js"]
    },
    "packages/extension": {
      "entry": ["src/markdownPreviewMain.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/integration": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/markdown-preview-worker": {
      "entry": ["src/markdownPreviewWorkerMain.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  }
}
